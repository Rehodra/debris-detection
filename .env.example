# ==============================================================================
# AquaTrace Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# Database Connection (PostgreSQL or SQLite for local dev)
# Example: postgresql+psycopg://postgres:password@localhost:5432/AquaTrace_db
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/AquaTrace_db

# API Configuration
API_BASE_URL=http://localhost:8000
API_V1_STR=/api/v1
PROJECT_NAME=AquaTrace Debris Detection API

# Machine Learning & Inference Settings
MODEL_PATH=ml/weights/best.pt
CONFIDENCE_THRESHOLD=0.50
DEMO_MODE=true

# Server Runtime Settings
DEBUG=true
HOST=0.0.0.0
PORT=8000
